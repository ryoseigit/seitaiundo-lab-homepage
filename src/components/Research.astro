---
import { researchTopics } from '../data/research';

const base = import.meta.env.BASE_URL;
---
<section id="research" class="research-section py-20">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-center mb-16">Research</h2>

    <div class="research-grid">
      {researchTopics.map((topic, index) => (
        <a
          href={`${base}research/${topic.slug}`}
          class="research-card group"
        >
          <div class="research-card-top">
            <span class="research-index">0{index + 1}</span>
            <span class="research-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="research-image-wrap">
            <img src={`${base}${topic.image}`} alt={topic.title} class="research-image" />
          </div>
          <div class="research-card-content">
            <h3 class="research-title">{topic.title}</h3>
            <p class="research-description">{topic.desc}</p>
            <span class="research-more">View research</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .research-section {
    background: #f5f7f4;
  }

  .research-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .research-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid #d8e2dd;
    border-radius: 0.5rem;
    background: #ffffff;
    color: #172a2b;
    box-shadow: 0 8px 24px rgb(23 42 43 / 0.05);
    transition: border-color 220ms ease, box-shadow 220ms ease, transform 220ms ease;
  }

  .research-card:hover {
    border-color: #0f766e;
    box-shadow: 0 16px 30px rgb(23 42 43 / 0.12);
    transform: translateY(-5px);
  }

  .research-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem 0;
  }

  .research-index {
    color: #0f766e;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .research-arrow {
    color: #7a9189;
    font-size: 1.25rem;
    line-height: 1;
    transition: color 220ms ease, transform 220ms ease;
  }

  .research-card:hover .research-arrow {
    color: #0f766e;
    transform: translate(2px, -2px);
  }

  .research-image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    margin: 0.75rem;
    border-radius: 0.35rem;
    background: #e9f1ed;
  }

  .research-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }

  .research-card:hover .research-image {
    transform: scale(1.08);
  }

  .research-card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.5rem 1.1rem 1.25rem;
  }

  .research-title {
    margin-bottom: 0.7rem;
    color: #155e75;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .research-description {
    display: -webkit-box;
    overflow: hidden;
    color: #526563;
    font-size: 0.82rem;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .research-more {
    margin-top: auto;
    padding-top: 1.25rem;
    color: #0f766e;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 640px) {
    .research-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 1280px) {
    .research-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

</style>