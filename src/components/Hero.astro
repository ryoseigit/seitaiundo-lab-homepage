---
import { posts } from "../data/posts";

const latestPosts = posts.slice(0, 4);
const mobilePosts = posts.slice(0, 2);
---

<section class="hero-shell relative flex h-screen items-center justify-center overflow-hidden text-white">
  <div class="hero-backdrop absolute inset-0"></div>

  <div class="hero-noise absolute inset-0"></div>

  <div class="hero-grid absolute inset-0 opacity-30"></div>

  <div class="absolute inset-0 overflow-hidden">
    <div class="ambient ambient-1"></div>
    <div class="ambient ambient-2"></div>
    <div class="ambient ambient-3"></div>

    <div class="helix helix-left"></div>
    <div class="helix helix-right"></div>

    <div class="molecule molecule-a"></div>
    <div class="molecule molecule-b"></div>
    <div class="molecule molecule-c"></div>
    <div class="molecule molecule-d"></div>
    <div class="molecule molecule-e"></div>
    <div class="molecule molecule-f"></div>
    <div class="molecule molecule-g"></div>
    <div class="molecule molecule-h"></div>
    <div class="molecule molecule-i"></div>
    <div class="molecule molecule-j"></div>
    <div class="molecule molecule-k"></div>
  </div>

  <div class="hero-side-panel absolute inset-y-0 right-0 hidden w-[40rem] items-center justify-center pr-8 lg:flex xl:w-[44rem]">
    <div class="hero-cards grid w-[28rem] grid-cols-2 gap-4 opacity-90 xl:w-[32rem] xl:gap-6">
      {latestPosts.map((post) => (
        <a
          href={`./blog/${post.id}`}
          class="group block overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-900/45 shadow-[0_20px_40px_rgba(15,23,42,0.45)] backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-cyan-300/50 hover:bg-slate-900/70 hover:shadow-[0_20px_60px_rgba(34,211,238,0.2)]"
        >
          <img src={post.image} alt={post.title} class="h-32 w-full object-cover opacity-90 transition duration-300 group-hover:scale-105 lg:h-40 xl:h-48" />
          <div class="space-y-2 p-4 lg:p-5 xl:p-6">
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-cyan-300 lg:text-[11px]">{post.category}</span>
              <span class="text-[9px] font-medium text-slate-300 lg:text-[10px]">{post.date}</span>
            </div>
            <div class="text-sm font-semibold text-white line-clamp-2 lg:text-base">{post.title}</div>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="hero-decor hero-orbit-top absolute -top-32 -right-24 h-72 w-72 rounded-full border border-cyan-300/30 animate-spin-slow"></div>
  <div class="hero-decor hero-orbit-left absolute left-10 top-20 h-20 w-20 rounded-full border border-violet-300/20 animate-pulse-slow"></div>
  <div class="hero-decor hero-orbit-bottom absolute bottom-16 left-1/4 h-24 w-24 rounded-full border border-cyan-300/20 animate-float-slow"></div>

  <div class="container z-10 mx-auto px-6 text-center animate-fade-in-up lg:text-left">
    <div class="mb-6 inline-block lg:mb-8">
      <span class="hero-badge inline-flex items-center gap-2 rounded-full border border-cyan-300/30 bg-slate-900/30 px-4 py-2 text-xs font-bold uppercase tracking-[0.25em] text-cyan-200 shadow-[0_0_30px_rgba(34,211,238,0.15)] backdrop-blur-md lg:px-5 lg:py-2.5">
        <span class="h-2 w-2 rounded-full bg-cyan-300 animate-pulse"></span>
        Biological motility Laboratory
      </span>
    </div>
    <h1 class="mb-8 text-5xl font-black leading-[0.95] tracking-[-0.04em] text-transparent bg-gradient-to-r from-cyan-100 via-sky-200 to-violet-200 bg-clip-text sm:text-6xl md:text-7xl lg:mb-10 lg:text-7xl xl:text-8xl 2xl:text-9xl">
      生体運動研究室
    </h1>
    <p class="mx-auto max-w-2xl text-base leading-relaxed text-slate-200/90 sm:text-lg md:text-xl lg:mx-0 lg:max-w-sm lg:text-xl xl:max-w-md xl:text-2xl 2xl:max-w-lg 2xl:text-3xl">
      アクチンは細胞の骨格を形作る主要なタンパク質です。私たちは、分子の動きと構造変化を観測しながら、生命現象を支える運動原理を明らかにしています。
    </p>
    <div class="mt-12 flex flex-col justify-center gap-4 sm:flex-row lg:justify-start lg:mt-14 lg:gap-5">
      <a href="#research" class="hero-button primary inline-block rounded-full px-8 py-4 text-base font-bold text-white transition duration-300 hover:-translate-y-1 lg:px-10 lg:py-5 lg:text-lg">
        研究内容を見る
      </a>
      <a href="#blog" class="hero-button secondary inline-block rounded-full border border-cyan-300/40 bg-slate-950/20 px-8 py-4 text-base font-bold text-cyan-200 transition duration-300 hover:-translate-y-1 hover:bg-cyan-400/10 lg:px-10 lg:py-5 lg:text-lg">
        最近のBlogを見る
      </a>
    </div>

    <div class="mt-8 flex justify-center lg:hidden">
      <div class="mobile-card-grid grid w-full max-w-sm grid-cols-2 gap-3 sm:gap-4">
        {mobilePosts.map((post) => (
          <a
            href={`./blog/${post.id}`}
            class="group block overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50 shadow-[0_12px_24px_rgba(15,23,42,0.35)] backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:border-cyan-300/50 hover:bg-slate-900/75"
          >
            <img src={post.image} alt={post.title} class="h-24 w-full object-cover opacity-90 transition duration-300 group-hover:scale-105 sm:h-28" />
            <div class="space-y-1 p-3 sm:p-4">
              <div class="flex items-center gap-2">
                <span class="text-[9px] font-bold uppercase tracking-[0.18em] text-cyan-300 sm:text-[10px]">{post.category}</span>
                <span class="text-[8px] font-medium text-slate-300 sm:text-[9px]">{post.date}</span>
              </div>
              <div class="text-xs font-semibold text-white line-clamp-2 sm:text-sm">{post.title}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2">
    <div class="flex flex-col items-center gap-2 animate-bounce">
      <span class="text-xs uppercase tracking-[0.35em] text-slate-300/80">Scroll</span>
      <svg class="h-5 w-5 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    background:
      radial-gradient(circle at top left, rgba(45, 212, 191, 0.18), transparent 28%),
      radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.22), transparent 30%),
      linear-gradient(135deg, rgba(2, 6, 23, 1) 0%, rgba(8, 47, 73, 1) 28%, rgba(15, 23, 42, 1) 58%, rgba(7, 10, 30, 1) 100%);
  }

  .hero-backdrop {
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 20% 25%, rgba(125, 211, 252, 0.18), transparent 18%),
      radial-gradient(circle at 70% 30%, rgba(99, 102, 241, 0.18), transparent 24%),
      radial-gradient(circle at 30% 70%, rgba(45, 212, 191, 0.16), transparent 22%);
    filter: blur(10px);
  }

  .hero-noise {
    z-index: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(circle at center, black 30%, transparent 100%);
  }

  .hero-grid {
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px), linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at center, black 35%, transparent 100%);
  }

  .ambient {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.8;
    animation: floaty 16s ease-in-out infinite alternate;
  }

  .ambient-1 {
    width: 30rem;
    height: 30rem;
    top: 8%;
    right: 12%;
    background: rgba(96, 165, 250, 0.22);
  }

  .ambient-2 {
    width: 26rem;
    height: 26rem;
    bottom: 4%;
    left: 10%;
    background: rgba(45, 212, 191, 0.2);
    animation-delay: 1.5s;
  }

  .ambient-3 {
    width: 20rem;
    height: 20rem;
    left: 45%;
    top: 20%;
    background: rgba(167, 139, 250, 0.18);
    animation-delay: 3s;
  }

  .helix {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    border: 1px solid rgba(125, 211, 252, 0.18);
    box-shadow: inset 0 0 32px rgba(125, 211, 252, 0.08), 0 0 40px rgba(22, 163, 74, 0.08);
    animation: orbit 24s linear infinite;
  }

  .helix::before,
  .helix::after {
    content: "";
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    border: 1px solid rgba(125, 211, 252, 0.06);
  }

  .helix::after {
    inset: 22%;
  }

  .helix-left {
    left: -8rem;
    top: 18%;
    transform: rotateX(62deg) rotateY(12deg);
  }

  .helix-right {
    right: -10rem;
    bottom: 8%;
    transform: rotateX(62deg) rotateY(-22deg);
    animation-delay: -10s;
  }

  .molecule {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8), rgba(125,211,252,0.2) 28%, rgba(15,118,110,0.04) 70%, transparent 100%);
    border: 1px solid rgba(147, 197, 253, 0.2);
    box-shadow: inset 0 0 16px rgba(125, 211, 252, 0.15), 0 0 24px rgba(34, 211, 238, 0.1);
    animation: drift 16s ease-in-out infinite alternate;
  }

  .molecule-a { width: 8rem; height: 8rem; left: 16%; top: 24%; }
  .molecule-b { width: 5rem; height: 5rem; left: 36%; top: 16%; animation-delay: 1s; }
  .molecule-c { width: 7rem; height: 7rem; right: 26%; top: 18%; animation-delay: 2s; }
  .molecule-d { width: 9rem; height: 9rem; right: 12%; bottom: 18%; animation-delay: 3s; }
  .molecule-e { width: 6rem; height: 6rem; left: 8%; bottom: 22%; animation-delay: 4s; }
  .molecule-f { width: 5rem; height: 5rem; left: 62%; bottom: 14%; animation-delay: 2.5s; }
  .molecule-g { width: 4.5rem; height: 4.5rem; left: 52%; top: 28%; animation-delay: 1.8s; }
  .molecule-h { width: 6.5rem; height: 6.5rem; right: 38%; top: 42%; animation-delay: 3.2s; }
  .molecule-i { width: 5.5rem; height: 5.5rem; left: 42%; bottom: 35%; animation-delay: 2.2s; }
  .molecule-j { width: 7rem; height: 7rem; right: 20%; bottom: 28%; animation-delay: 3.5s; }
  .molecule-k { width: 5.5rem; height: 5.5rem; left: 24%; top: 55%; animation-delay: 0.8s; }

  .hero-side-panel {
    position: absolute;
    z-index: 20;
    pointer-events: none;
  }

  .hero-cards {
    position: relative;
    z-index: 30;
    pointer-events: auto;
    animation: cardFloat 18s ease-in-out infinite alternate;
  }

  .hero-cards a {
    pointer-events: auto;
  }

  .hero-decor {
    z-index: 0;
    pointer-events: none;
  }

  .mobile-card-grid {
    pointer-events: auto;
    z-index: 25;
  }

  .mobile-card-grid a {
    pointer-events: auto;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .hero-button.primary {
    box-shadow: 0 24px 40px rgba(34, 211, 238, 0.3), inset 0 1px 0 rgba(255,255,255,0.25);
    background: linear-gradient(135deg, rgba(34, 211, 238, 0.95), rgba(59, 130, 246, 0.95));
  }

  .hero-button.secondary {
    box-shadow: inset 0 0 0 1px rgba(125, 211, 252, 0.25), 0 10px 30px rgba(14, 116, 144, 0.15);
  }

  @keyframes floaty {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(26px, -18px, 0) scale(1.08); }
  }

  @keyframes orbit {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.05); }
    100% { transform: rotate(360deg) scale(1); }
  }

  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(18px, -22px) scale(1.08); }
    100% { transform: translate(-12px, 18px) scale(0.94); }
  }

  @keyframes cardFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-12px); }
  }

  .animate-spin-slow {
    animation: spin 28s linear infinite;
  }

  .animate-pulse-slow {
    animation: pulse 4s ease-in-out infinite;
  }

  .animate-float-slow {
    animation: floaty 9s ease-in-out infinite alternate;
  }
</style>