---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import { researchTopics } from "../../data/research";

const base = import.meta.env.BASE_URL;

export function getStaticPaths() {
  return researchTopics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic }
  }));
}

const { topic } = Astro.props as { topic: (typeof researchTopics)[number] };
---

<Layout title={`${topic.title} | 生体運動研究室`}>
  <Header />
  <main class="pt-28 pb-20 bg-slate-50 min-h-screen">
    <article class="container mx-auto px-6 max-w-5xl bg-white shadow-sm rounded-xl overflow-hidden">
      <div class="p-8 md:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">Research</p>
        <h1 class="text-3xl md:text-4xl font-bold mt-3 mb-6 leading-tight">{topic.title}</h1>

        <div class="mb-8 overflow-hidden rounded-xl border border-slate-200 bg-slate-50 p-4 md:p-6">
          <img
            src={`${base}${topic.image}`}
            alt={topic.title}
            class="mx-auto h-56 w-full max-w-2xl object-contain md:h-72"
          />
        </div>

        <p class="text-lg text-slate-700 leading-relaxed">{topic.overview}</p>

        <div class="mt-8 rounded-xl border border-slate-200 p-6 bg-slate-50">
          <h2 class="text-xl font-semibold text-slate-900">概要</h2>
          <div class="mt-4 space-y-4 text-slate-700 leading-relaxed">
            {topic.details.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={`${base}#research`}
            class="inline-flex items-center px-5 py-3 rounded-full bg-blue-600 text-white text-sm font-semibold hover:bg-blue-500 transition"
          >
            研究一覧へ戻る
          </a>
          <a
            href={base}
            class="inline-flex items-center px-5 py-3 rounded-full border border-slate-200 text-slate-700 text-sm font-semibold hover:bg-slate-50 transition"
          >
            トップページへ
          </a>
        </div>
      </div>
    </article>
  </main>
</Layout>
